# Salinan template — JANGAN isi secret asli di berkas ini.
# Salin ke .env lalu isi. .env diabaikan git.

# --- Database -------------------------------------------------------------
# Postgres 16 lokal (dev) atau connection pooler Supabase (produksi).
DATABASE_URL=
# Database khusus test integrasi. Wajib terpisah dari DATABASE_URL.
TEST_DATABASE_URL=

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya untuk server. Tidak boleh bocor ke bundle browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Midtrans -------------------------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# true = jangan panggil Midtrans sungguhan (dev & E2E).
MOCK_MIDTRANS=false

# --- WhatsApp gateway -----------------------------------------------------
WHATSAPP_GATEWAY_PROVIDER=fonnte
WA_GATEWAY_PROVIDER=fonnte
FONNTE_TOKEN=
FONNTE_API_URL=
WABLAS_TOKEN=
WABLAS_SECRET_KEY=
WABLAS_API_URL=
WHATSAPP_TIMEOUT_MS=5000
# true = jangan kirim WhatsApp sungguhan (dev & E2E).
MOCK_WHATSAPP=false

# --- Aplikasi -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Minimal 16 karakter. Melindungi seluruh route /api/cron/*.
CRON_SECRET=
# Interval worker auto-expire slot, milidetik.
EXPIRE_WORKER_INTERVAL_MS=60000
