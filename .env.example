# ==============================================================================
# DAMEZ BARBERSHOP - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Panduan Lengkap: Lihat docs/DEPLOYMENT.md
# Jangan pernah commit file .env aktual ke repositori git publik.
# Gandakan file ini menjadi .env sebelum menjalankan aplikasi:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth Configuration
# ------------------------------------------------------------------------------
# URL project dashboard Supabase (Format: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Public Key (Digunakan di frontend Next.js untuk query publik & auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Secret Key (Wajib Server-Side Only; Bypass RLS untuk webhook & worker)
# PERINGATAN: Jangan pernah mengekspos kunci ini ke sisi browser/client!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# (Opsional) URL Fallback jika tidak menggunakan prefix NEXT_PUBLIC
SUPABASE_URL=https://your-project.supabase.co

# ------------------------------------------------------------------------------
# 2. Midtrans Payment Gateway Configuration (Snap API & Webhook)
# ------------------------------------------------------------------------------
# Mode Lingkungan Midtrans:
# - 'false' : Mode Sandbox (https://app.sandbox.midtrans.com)
# - 'true'  : Mode Production (https://app.midtrans.com)
MIDTRANS_IS_PRODUCTION=false

# Midtrans Server Key (Digunakan server-side untuk inisialisasi Snap token & verifikasi SHA-512)
# Sandbox prefix: SB-Mid-server-xxxx | Production prefix: Mid-server-xxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx

# Midtrans Client Key (Digunakan di frontend untuk memuat pop-up Snap JS)
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx

# Mode Mock Offline Midtrans (Wajib 'false' untuk pengujian gateway sungguhan)
# Set 'true' saat CI/CD offline atau pengujian unit test tanpa koneksi internet
MOCK_MIDTRANS=false

# ------------------------------------------------------------------------------
# 3. WhatsApp Notification Gateway Service (Fonnte / Wablas)
# ------------------------------------------------------------------------------
# Provider aktif: 'fonnte', 'wablas', atau 'mock' (default: 'fonnte')
WHATSAPP_GATEWAY_PROVIDER=fonnte
WA_GATEWAY_PROVIDER=fonnte

# Kredensial Provider Fonnte (https://fonnte.com)
# Token autentikasi API Fonnte dari menu Device / API Token
FONNTE_API_TOKEN=your-fonnte-api-token
FONNTE_TOKEN=your-fonnte-api-token
WA_GATEWAY_TOKEN=your-fonnte-api-token
FONNTE_API_URL=https://api.fonnte.com/send

# Kredensial Provider Wablas (https://wablas.com)
# Digunakan jika WHATSAPP_GATEWAY_PROVIDER=wablas atau sebagai failover
WABLAS_TOKEN=your-wablas-token
WABLAS_SECRET_KEY=your-wablas-secret-key
WABLAS_API_URL=https://wablas.com/api/v2/send-message

# Mode Mock Offline WhatsApp (Set 'true' untuk testing lokal tanpa mengirim pesan WA sungguhan)
MOCK_WHATSAPP=false

# Timeout Request HTTP Gateway WhatsApp (dalam milidetik, default: 4500 ms demi menjaga SLA < 5 detik)
WHATSAPP_TIMEOUT_MS=4500

# Nomor Telepon Resmi & Notifikasi Internal
# Format: Nomor seluler Indonesia diawali angka 0 atau 62 (contoh: 081234567890)
WHATSAPP_DEFAULT_ADMIN_PHONE=081234567890
WHATSAPP_DEFAULT_BARBER_PHONE=081234567890

# Kontak Master Barber per Kursi (Penerima Alert Reservasi Baru Masuk)
BARBER_RIAN_PHONE=081234567801
BARBER_FAJAR_PHONE=081234567802
BARBER_BAGAS_PHONE=081234567803

# ------------------------------------------------------------------------------
# 4. Domain & Web Application Configuration
# ------------------------------------------------------------------------------
# URL domain utama website (Digunakan untuk metadata SEO, link WhatsApp, dan Webhook callback)
# Development : http://localhost:3000
# Production  : https://damezbarber.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mode Lingkungan Node.js ('development', 'production', atau 'test')
NODE_ENV=development

# ------------------------------------------------------------------------------
# 5. Slot Auto-Expire & Scheduled Background Worker Configuration
# ------------------------------------------------------------------------------
# Kunci Rahasia Otorisasi HTTP Cron (Melindungi route /api/cron/* dari eksekusi liar)
# Header request: Authorization: Bearer <CRON_SECRET> atau X-Cron-Secret: <CRON_SECRET>
CRON_SECRET=damez_secret_cron_token_15m

# Interval Polling Worker Auto-Expire (dalam milidetik, default: 15000 ms = 15 detik)
# Digunakan oleh: npm run worker:expire (scripts/slot-expire-worker.ts)
EXPIRE_WORKER_INTERVAL_MS=15000
